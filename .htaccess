RewriteEngine On

# Redirect legacy .php URLs to clean slugs.
RewriteRule ^index\.php$ / [R=301,L]
RewriteRule ^(about|why-us|doctors|services|appointments|contact|testimonials|clinic-tour)\.php$ /$1 [R=301,L,NC]

# Existing files/directories are served directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Map clean routes to PHP files.
RewriteRule ^$ index.php [L]
RewriteRule ^(about|why-us|doctors|services|appointments|contact|testimonials|clinic-tour)/?$ $1.php [L,NC]
